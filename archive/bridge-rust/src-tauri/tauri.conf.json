{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundCloud Remote Bridge",
  "version": "0.2.0",
  "identifier": "com.pandemias.soundcloud-remote-bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoundCloud Remote — мост",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  }
}
